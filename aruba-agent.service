# /etc/systemd/system/aruba-agent.service
#
# Installation:
#   sudo useradd -r -s /sbin/nologin aruba-agent
#   sudo mkdir -p /opt/aruba-agent /etc/aruba-agent /var/lib/aruba-agent
#   sudo cp -r Network\ Agent/* /opt/aruba-agent/
#   sudo cp config.ini /etc/aruba-agent/config.ini
#   sudo chmod 600 /etc/aruba-agent/config.ini
#   sudo chown -R aruba-agent:aruba-agent /opt/aruba-agent /var/lib/aruba-agent
#   pip3 install requests urllib3 flask scapy
#   sudo cp aruba-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aruba-agent
#
# Logs:
#   journalctl -u aruba-agent -f
#
# Web UI:
#   http://<host>:8080

[Unit]
Description=Aruba All-in-One Network Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/aruba-agent/main.py /etc/aruba-agent/config.ini
WorkingDirectory=/opt/aruba-agent
Restart=on-failure
RestartSec=10

# Explicit output capture — routes stdout+stderr to the systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aruba-agent

# Dedicated low-privilege user
User=aruba-agent
Group=aruba-agent

# CAP_NET_RAW — Scapy ICMP scanning for switch auto-discovery
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# File descriptor headroom. The default per-process soft limit on
# most distros (1024) is not enough for a 200+ switch fleet. Every
# active SwitchMonitor thread keeps a pysnmp engine open with its
# own UDP transport, plus pysnmp churns short-lived sockets per
# request. We've seen the agent climb to ~1500 fds in normal
# steady-state operation and hit ValueError: filedescriptor out
# of range in select() inside waitress's poll loop. Bumping to
# 65536 gives us 60× headroom and is a noop on systems that
# don't need it.
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
# /var/log/aruba-agent is the dedicated audit log path (v3.0.1+).
# Must be in ReadWritePaths for the AuditLogger to append on append/rotate.
ReadWritePaths=/var/lib/aruba-agent /etc/aruba-agent /var/log/aruba-agent

[Install]
WantedBy=multi-user.target
