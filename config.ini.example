# /etc/aruba-agent/config.ini
# ============================================================
# Aruba All-in-One Agent — configuration TEMPLATE
#
# This file ships in the repo as `config.ini.example`. The real
# config.ini is gitignored because it holds credentials.
#
# To deploy:
#     sudo cp config.ini.example /etc/aruba-agent/config.ini
#     sudo chown root:aruba-agent /etc/aruba-agent/config.ini
#     sudo chmod 640              /etc/aruba-agent/config.ini
#     sudo nano                   /etc/aruba-agent/config.ini
# ============================================================


# ------------------------------------------------------------
# Agent-wide settings
#
# state_file       — JSON snapshot of in-memory state (registered
#                    switches, last backup result, scanner inventory,
#                    per-location ARP timestamps). Reloaded at startup
#                    so the dashboard survives reboots and restarts.
#                    The aruba-agent service account must be able to
#                    write to this path.
#
# master_key_file  — Fernet master key used to encrypt every
#                    sensitive field in this config (passwords,
#                    RADIUS secret, SNMPv3 auth/priv passphrases,
#                    web secret_key). Generated automatically on
#                    first start with mode 0600.
#
#                    On first start the agent walks every sensitive
#                    field and rewrites cleartext values to their
#                    encrypted form (prefixed `enc:`). A one-time
#                    `.bak` copy of the original config is kept
#                    beside it so you have a recovery path.
#
#                    If you lose master.key you lose every encrypted
#                    password — the agent will read them back as
#                    empty strings and you'll need to re-enter them
#                    through Settings → Credentials, Settings → Email,
#                    etc. BACK THIS FILE UP.
# ------------------------------------------------------------
[agent]
state_file           = /var/lib/aruba-agent/state.json
master_key_file      = /etc/aruba-agent/master.key
# audit_log_file     = /var/log/aruba-agent/audit.log    ; default if unset
# alert_dedup_minutes — suppress repeat DOWN/RESTORED emails per switch
#                       within this window. 5 = one email of each kind
#                       per switch per 5 min. 0 disables (every flap
#                       fires its own email).
alert_dedup_minutes  = 5
# v3.0.3: manual_hosts_file — hosts outside the scanner's subnets that
# operators add via Settings → Manual Hosts. Each entry carries a
# monitor_mode (icmp / snmp_ro / snmp_rw / auto). Default location
# matches the rest of /var/lib/aruba-agent/ runtime data.
manual_hosts_file    = /var/lib/aruba-agent/manual_hosts.json


# ------------------------------------------------------------
# SNMPv3 reachability
#
# When enabled, the 30-second switch reachability poll uses a single
# SNMPv3 GET on sysUpTime.0 instead of opening a vendor REST/SSH
# session every poll. Eliminates AOS-CX session churn entirely
# (no session = no leak), works identically across Aruba / Cisco /
# Arista, and cuts the agent's management-plane chattiness by an
# order of magnitude.
#
# Required on the switch side:
#   * SNMPv3 user with at least read-only access to sysUpTime.0,
#     sysName.0, sysObjectID.0, sysDescr.0
#   * Auth + priv passwords matching the values below
#
# Recommended security level: authPriv (auth+encryption).
# Acceptable: authNoPriv. Avoid: noAuthNoPriv.
#
# username           — SNMPv3 USM user (a.k.a. Security Name)
# context_name       — Default SNMPv3 context (used when vendor is
#                      not yet known, and as the fallback for
#                      vendors not listed below).
# context_engine_id  — hex string, blank = auto-discover. Set only if
#                      your switch refuses the standard handshake.
# auth_protocol      — NONE | MD5 | SHA | SHA224 | SHA256 | SHA384 | SHA512
# auth_password      — auth pass-phrase (>= 8 chars per RFC 3414)
# priv_protocol      — NONE | DES | AES128 | AES192 | AES256
# priv_password      — privacy pass-phrase
# port               — UDP port (161 standard)
# timeout            — per-request timeout in seconds
# retries            — retry count before declaring the host down
#
# Per-vendor context overrides
# ----------------------------
# Real fleets often need different SNMPv3 contexts per vendor.
# Aruba CX commonly scopes its monitoring user under a named
# context (e.g. 'network'), while Cisco IOS-XE and Arista EOS
# leave the user in the default empty context.
#
# Each key is optional. Set to an explicit empty value to force
# the empty default context for that vendor.
#
# context_name_aruba_cx    — for Aruba CX switches
# context_name_cisco_ios   — for Cisco IOS / IOS-XE
# context_name_arista_eos  — for Arista EOS
# context_name_aruba_os    — for legacy AOS-S / AOS-W
# ------------------------------------------------------------
[snmp]
enabled                 = false
username                = aruba_monitoring
context_name            =
context_engine_id       =
auth_protocol           = SHA
auth_password           = ChangeMeAuthPassphrase
priv_protocol           = AES128
priv_password           = ChangeMePrivPassphrase
port                    = 161
timeout                 = 2
retries                 = 1
# Per-vendor context overrides (uncomment + adjust as needed):
#context_name_aruba_cx   = network
#context_name_cisco_ios  =
#context_name_arista_eos =


# ------------------------------------------------------------
# SNMPv3 profiles (multi-credential)
#
# When the legacy [snmp] block above has just one set of credentials,
# the agent treats it as a single profile called 'default'. Real
# fleets often need MULTIPLE profiles — different credentials,
# different SNMPv3 contexts — for different vendors that share the
# same monitoring user but bind it differently:
#
#   * Aruba CX user 'nets' bound to context 'network'
#   * Cisco IOS user 'nets' in default empty context
#   * Arista EOS user 'nets' in default empty context
#
# Define one [snmp.<name>] section per profile. The detector will
# try them in order on a never-classified host and pin the winner
# to that host (state.snmp_profile) so subsequent polls go straight
# to the right one.
#
# Optional: [snmp] default_profile = <name>  picks which profile
# the detector tries first. Defaults to 'default' if not set.
#
# Example mixed-fleet configuration:
#
#     [snmp]
#     enabled         = true
#     default_profile = aruba
#
#     [snmp.aruba]
#     username      = nets
#     auth_protocol = SHA
#     auth_password = ChangeMeAuth
#     priv_protocol = AES128
#     priv_password = ChangeMePriv
#     context_name  = network
#
#     [snmp.cisco]
#     username      = nets
#     auth_protocol = SHA
#     auth_password = ChangeMeAuth
#     priv_protocol = AES128
#     priv_password = ChangeMePriv
#     context_name  =
#
#     [snmp.arista]
#     username      = nets
#     auth_protocol = SHA
#     auth_password = ChangeMeAuth
#     priv_protocol = AES128
#     priv_password = ChangeMePriv
#     context_name  =
#
# When [snmp.<name>] sections exist, the credentials directly
# in [snmp] above are IGNORED — only the [snmp]-level enabled /
# default_profile keys still matter. Keep one profile shape or
# the other in any single config; mixing causes the [snmp]-level
# credentials to be silently overridden.
# ------------------------------------------------------------


# ------------------------------------------------------------
# Shared switch credentials (Aruba AOS-CX REST)
# Used by the AOS-CX driver as defaults. Individual
# [switch.*] / [arp.*] sections can override username / password.
# ------------------------------------------------------------
[credentials]
username = admin
password = YourSwitchPassword


# ------------------------------------------------------------
# Cisco IOS / IOS-XE credentials (NAPALM via SSH)
#
# Used when the C3 vendor detector classifies a switch as cisco_ios.
# If username / password are blank here, the driver falls back to
# the [credentials] block above.
#
# enable_secret  — privileged-exec password. Optional but commonly
#                  required on traditional IOS images.
# napalm_driver  — which NAPALM Cisco driver to use:
#                    ios       Catalyst / IOS / IOS-XE   (default)
#                    iosxr     IOS-XR  (carrier-grade)
#                    nxos_ssh  Nexus / NX-OS via SSH
# ------------------------------------------------------------
[credentials.cisco]
username      =
password      =
enable_secret =
napalm_driver = ios
# v3.0.3: SSH public-key auth. When key_file is set, NAPALM uses the
# private key for SSH auth instead of the password — the password
# field above becomes the key's passphrase (empty for unencrypted).
# Install the matching PUBLIC key on each switch under the username
# above:
#     conf t
#     ip ssh pubkey-chain
#       username monitoring
#         key-string
#           ssh-ed25519 AAAA…
#         exit
#       exit
# Key file must be mode 600, owned by the aruba-agent service account.
key_file      =


# ------------------------------------------------------------
# Arista EOS credentials (NAPALM via eAPI / HTTPS)
#
# Used when the C3 vendor detector classifies a switch as arista_eos.
# If username / password are blank here, the driver falls back to
# the [credentials] block above.
#
# Requires eAPI enabled on the switch:
#     management api http-commands
#        no shutdown
#        protocol https
#
# enable_password — privileged-exec password. Optional.
# transport       — https (default) or http. https is strongly
#                   recommended; http is mostly for lab use.
# port            — eAPI port. Blank = NAPALM default (443 for
#                   https, 80 for http).
# ------------------------------------------------------------
[credentials.arista]
username        =
password        =
enable_password =
transport       = https
port            =


# ------------------------------------------------------------
# SMTP — email alert settings
# ------------------------------------------------------------
[smtp]
enabled  = false
host     = smtp.gmail.com
port     = 587
use_tls  = true
username = alerts@example.com
password = YourSmtpAppPassword
from     = Aruba Monitoring <alerts@example.com>
# Comma-separated list of recipients
to       = noc@example.com, admin@example.com


# ------------------------------------------------------------
# Web UI
# In production the dashboard is reached via the Apache2 HTTPS
# reverse proxy on :443. Apache forwards to the WSGI backend
# (waitress) on 127.0.0.1:8080, which is why the default host
# below is 127.0.0.1 — the listener is NOT exposed to the network.
#
# Server stack:
#   browser  →  Apache (TLS, :443)  →  waitress (WSGI, :8080)  →  Flask
#
# host                  — interface waitress binds to.
#                         127.0.0.1   — production (Apache fronts it)
#                         0.0.0.0     — direct access (no Apache)
#
# threads               — waitress worker-thread count. 8 is plenty
#                         for an internal dashboard with ~20 concurrent
#                         operators. Increase if /api/state polls back
#                         up under load.
#
# secret_key            — session cookie signing key.
#                         Generate one with:
#                           python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#                         MUST be set in production; otherwise sessions
#                         will be invalidated on every agent restart.
#
# session_timeout_hours — how long a login session remains valid.
#
# secure_cookies        — set to true when fronted by HTTPS (Apache2
#                         reverse proxy on :443). Set to false ONLY
#                         during initial direct-HTTP development.
#
# trust_proxy_headers   — set to true when running behind Apache.
#                         Enables werkzeug ProxyFix so the audit log
#                         sees real client IPs (X-Forwarded-For) and
#                         url_for() generates https:// URLs.
# ------------------------------------------------------------
[web]
host                  = 127.0.0.1
port                  = 8080
# metrics_token — bearer token required to scrape GET /metrics.
# Blank = no auth (fine on a trusted LAN behind Apache). Set to a
# long random string to require:
#     Authorization: Bearer <token>
# on Prometheus's scrape config.
metrics_token         =
# threads — waitress worker pool. 16 gives the dashboard enough
# headroom on a 200-switch fleet where 200 SwitchMonitor threads
# compete for the GIL. Bump to 32 if /api/state still queues under
# load.
threads               = 16
secret_key            =
session_timeout_hours = 8
secure_cookies        = true
trust_proxy_headers   = true


# ------------------------------------------------------------
# Local Authentication
# A built-in user store that always works as a fallback to RADIUS.
# Login order is: local first, RADIUS second — so a RADIUS outage
# can't lock the operator out.
#
# On first start the store bootstraps a default admin / admin
# user with must_change=true. On first login the operator is
# forced to set a real password before the dashboard becomes
# usable.
#
# enabled    — master switch for the local user backend.
# store_file — JSON file holding scrypt-hashed credentials.
#              Mode 0600, owned by aruba-agent.
# ------------------------------------------------------------
[local_auth]
enabled    = true
store_file = /var/lib/aruba-agent/users.json


# ------------------------------------------------------------
# RADIUS Authentication
# Session-based login on the web dashboard validated against a
# RADIUS server using classic PAP on UDP 1812. Optional — local
# auth above is always available as a fallback.
#
# enabled        — master switch.
# server         — RADIUS server IP or hostname
# secret         — shared secret configured on the RADIUS server
#                  for this NAS (the agent host).
# port           — auth port (1812 is standard)
# nas_identifier — string sent to the RADIUS server to identify
#                  this NAS. Defaults to the host's hostname.
# timeout        — per-request timeout in seconds
# retries        — retry count before giving up
# ------------------------------------------------------------
[radius]
enabled        = false
server         = 10.0.0.50
secret         = ChangeMeSharedSecret
port           = 1812
nas_identifier = aruba-switch-manager
timeout        = 5
retries        = 2


# ------------------------------------------------------------
# Switch reachability monitors
# One [switch.<display-name>] section per AOS-CX 6300M.
# username / password inherit from [credentials] if omitted.
# ------------------------------------------------------------
[switch.core-sw-01]
host              = 192.168.1.1
verify_ssl        = false
poll_interval     = 30
failure_threshold = 3

[switch.core-sw-02]
host              = 192.168.1.2
verify_ssl        = false
poll_interval     = 30
failure_threshold = 3


# ------------------------------------------------------------
# Network Scanner Task
# Runs first — scans subnets via ICMP, then identifies Aruba
# switches in two passes:
#
#   1. Fast path: hostname matches one of filter_keywords.
#   2. Slow path (verify_via_api): for every responder that
#      DIDN'T match the keyword filter, attempt an AOS-CX REST
#      login. If the switch authenticates, it's Aruba — include
#      it regardless of DNS naming. Cisco / non-Aruba devices
#      reject the login and stay excluded.
#
# This recovers Aruba switches that have missing PTR records or
# non-matching naming conventions (6200, 6400, 8325, 2930F, etc.)
# Probe runs across api_workers threads so it doesn't blow out
# scan time on large campuses.
#
# Requires scapy + CAP_NET_RAW capability.
# ------------------------------------------------------------
[scanner]
enabled          = true
schedule         = 00:00
subnets          = 10.40.0.0/24,10.80.0.0/24,10.120.0.0/24,172.16.2.0/24
exclude_suffixes = 1,2,3,255
filter_keywords  = 6100,6300,Aruba
device_file      = /var/lib/aruba-agent/network_devices.csv
ip_list_output   = /var/lib/aruba-agent/ip_list.txt
icmp_timeout     = 8        # raise if not all switches reply in time
verify_via_api   = true     # REST-probe non-matching responders
api_workers      = 16       # parallel REST logins during verify
# Coverage safeguard: if a scan discovers sharply fewer switches than the
# previous run, it's almost always a discovery regression (routing / DNS /
# credentials), not switches actually disappearing.
coverage_drop_alert_pct = 25    # % drop that triggers an alert (0 disables)
coverage_guard          = true  # on breach, KEEP the previous ip_list instead
                                #  of overwriting — prevents monitoring/backup
                                #  coverage from silently collapsing


# ------------------------------------------------------------
# Config Backup Task
# Reads ip_list generated by the scanner above.
# ip_list path must match scanner.ip_list_output.
# ------------------------------------------------------------
[backup]
enabled        = true
schedule       = 02:00
ip_list        = /var/lib/aruba-agent/ip_list.txt
backup_path    = /var/lib/aruba-agent/backups
retention_days = 7
# Uncomment to pin API version instead of auto-detecting:
# api_version  = v10.13


# ------------------------------------------------------------
# ARP Discovery Tasks
# One [arp.<location>] section per campus location.
# Requires nmap installed on the agent host.
#
# retention_days — keep the N most recent CSV files per location and
#                  prune the rest at the end of each run. Default 30.
#                  Set 0 to disable pruning (history grows forever).
# ------------------------------------------------------------
[arp.location-1]
enabled        = true
schedule       = 01:00
routers        = 10.253.0.12,10.253.0.13
ip_list        = /etc/aruba-agent/subnets/loc1_ip_list.txt
output_dir     = /var/lib/aruba-agent/arp/location-1
retention_days = 30

[arp.location-2]
enabled        = true
schedule       = 01:15
routers        = 10.253.0.14,10.253.0.15
ip_list        = /etc/aruba-agent/subnets/loc2_ip_list.txt
output_dir     = /var/lib/aruba-agent/arp/location-2
retention_days = 30


# ------------------------------------------------------------
# Firmware Update (on-demand only)
# Run:  python main.py config.ini --firmware-update
# ip_list path should match scanner.ip_list_output after a
# scan has run, or set to a manual list.
# ------------------------------------------------------------
[firmware]
ip_list        = /var/lib/aruba-agent/ip_list.txt
target_version = 10.13.1150
image_path     = /var/lib/aruba-agent/firmware/ArubaOS-CX_6400-6300_10_13_1150.swi
max_workers    = 2
